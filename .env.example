# NE PAS COMMITTER CE FICHIER SUR GITHUB
# Copier ce fichier en .env et remplir les valeurs

SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL
DB_NAME=kbeauty_db
DB_USER=kbeauty_user
DB_PASSWORD=kbeauty_password
DB_HOST=localhost
DB_PORT=5432

# Pour dev local avec SQLite sans Docker
USE_SQLITE=True

# Chatbot IA (optionnel - fonctionne sans avec des réponses de secours)
# Obtenez votre clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici
